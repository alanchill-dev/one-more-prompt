{
  "name": "one-more-prompt",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first Codex usage and prompt activity dashboard for macOS and Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "./scripts/build-release.sh",
    "build:windows-portable": "./scripts/build-windows-portable.sh",
    "ccusage:bump": "bun ./scripts/bump-ccusage-version.mjs",
    "version:bump": "bun ./scripts/bump-version.mjs",
    "bundle:plugins": "bun copy-bundled.cjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage.enabled",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^29.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "source-map-js": "1.2.2",
    "picomatch": "4.0.4",
    "undici": "7.29.1",
    "vite": "8.1.6"
  }
}
