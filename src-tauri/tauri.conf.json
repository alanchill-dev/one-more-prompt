{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "One More Prompt",
  "version": "1.0.0",
  "identifier": "com.alanchill.onemoreprompt",
  "build": {
    "beforeDevCommand": "bun run bundle:plugins && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run bundle:plugins && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "One More Prompt",
        "width": 1240,
        "height": 875,
        "minWidth": 980,
        "maxWidth": 1440,
        "minHeight": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' tauri://localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bundled_plugins/**/*",
      "icons/tray-icon.png",
      "icons/icon.png",
      "icons/icon.icns",
      "../LICENSE",
      "../NOTICE"
    ]
  }
}
